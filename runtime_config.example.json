{
  "area_threshold": 10,
  "camera_flood_detection_enabled": false,
  "stage_threshold": 50,
  "monitoring_frequency": 60,
  "emergency_frequency": 5,
  "photo_interval": 60,
  "neighborhood_emergency_frequency": 30,
  "emergency_mode": false,
  "debug_mode": false,
  "always_transmit_sensors": false,
  "lora_full_send_hours": 24,
  "lora_imu_threshold_deg": 2.0,
  "coreg_tilt_threshold_deg": 5.0,
  "coreg_rotation_threshold_deg": 15.0,

  "auto_shutdown_enabled": true,
  "shutdown_iteration_limit": 3,
  "max_awake_minutes": 60,
  "data_retention_days": 0,
  "audio_recording_enabled": false,
  "ip_fallback_after_hours": 12,
