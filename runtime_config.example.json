{
  "area_threshold": 10,
  "stage_threshold": 50,
  "monitoring_frequency": 60,
  "emergency_frequency": 5,
  "photo_interval": 60,
  "neighborhood_emergency_frequency": 30,
  "emergency_mode": false,
  "debug_mode": false,
  "always_transmit_sensors": false,
  "lora_full_send_hours": 24,

  "max_retransmissions": 3,
  "auto_shutdown_enabled": true,
  "shutdown_iteration_limit": 3,
  "data_retention_days": 7,
  "backup_enabled": true,

  "ip_upload": {
    "enabled": false,
    "server_url": "http://<server-hostname>:8000",
    "api_key": "",
    "device_id": "watercam-001",
    "timeout_s": 15,
    "retry_attempts": 3,
    "retry_backoff_s": 2,
    "fallback_to_lora": true,
    "only_if_lora_unavailable": true,
    "cellular_connection": "Quectel",
    "cellular_connect_timeout_s": 90,
    "downlink_poll_interval_s": 60,
    "max_queue_depth": 48,
    "max_queue_age_days": 7
  },

  "recovery_boot": {
    "enabled": true,
    "min_delay_minutes": 120,
    "fallback_delay_minutes": 120,
    "scheduled_wake_window_minutes": 20
  }
}
