    "wifi_grace_s": 45,
    "downlink_poll_interval_s": 60,
    "max_queue_depth": 48,
    "max_queue_age_days": 7
  },

  "recovery_boot": {
    "enabled": true,
    "min_delay_minutes": 120,
    "fallback_delay_minutes": 120,
    "scheduled_wake_window_minutes": 20
  },

  "lora_thresholds": {
    "temperature_celsius": 0.5,
    "relative_humidity": 3,
    "camera_water_pct": 5,
    "battery_percent": 2,
    "pose_tilt_tenths": 10
  }
