#!/bin/bash
set -euo pipefail

DEVICE="/dev/ttyUSB2"

# 115200 baud, raw mode. -hupcl and redundant flags omitted: USB serial drivers
# reject them and stty exits non-zero, aborting the script under set -e.
stty -F "$DEVICE" 115200 raw -echo

# Open bidirectional fd to avoid ENXIO on write-only open of a tty
exec 3<>"$DEVICE"
sleep 0.1

# EC25 returns ERROR if GNSS is already running — that is acceptable
printf 'AT+QGPS=1\r\n' >&3
sleep 0.5
exec 3>&-
