#!/bin/bash
set -euo pipefail

DEVICE="/dev/ttyUSB2"

# Open bidirectional fd to avoid ENXIO on write-only open of a tty
# stty is not used: the EC25 USB serial port rejects mode changes but works
# fine at its default settings for AT command communication.
exec 3<>"$DEVICE"
sleep 0.1

# EC25 returns ERROR if GNSS is already running — that is acceptable
printf 'AT+QGPS=1\r\n' >&3
sleep 0.5
exec 3>&-
