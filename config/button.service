[Unit]
Description=Python script to perform an action on button press - like taking photos
After=multi-user.target

[Service]
User=pi
Group=pi
Type=idle
WorkingDirectory=/home/pi/SU-WaterCam
# Unbuffered stdout, so print() output reaches the journal as it happens.
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/pi/SU-WaterCam/venv/bin/python3 /home/pi/SU-WaterCam/button_hold_camera.py

# Sandbox (#207). It drives the cameras, GPIO and I2C, so no device or /sys
# limits and no syscall filter (libcamera); it runs no doas.
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ReadWritePaths=/home/pi /tmp /run/lock
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
