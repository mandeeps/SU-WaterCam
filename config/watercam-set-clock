#!/bin/bash
# Set the system clock and the Witty Pi RTC to a Unix time from the API's reply
# (tools/transmit_ip.py correct_clock), LoRa network time (tools/lora_time.py)
# or a GPS fix (tools/gps_window.py). Installed root-owned in /usr/local/sbin;
# pi runs it through doas (config/doas.conf). Refuses anything that isn't a
# plain integer between 2026-01-01 and 2100-01-01. Writes the RTC itself, as the
# Witty Pi's system_to_rtc does, rather than sourcing its pi-writable scripts.
set -eu
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
ts=${1:-}
# The source, for /run/watercam-time-source: one of a fixed list, never free text
source=${2:-server}
[[ "$ts" =~ ^[0-9]{10}$ ]] || { echo "usage: watercam-set-clock UNIX_TIME [server|lora|gps]" >&2; exit 2; }
[[ "$source" =~ ^(server|lora|gps)$ ]] || { echo "source must be server, lora or gps" >&2; exit 2; }
(( ts >= 1767225600 && ts < 4102444800 )) || { echo "time out of range" >&2; exit 2; }
date -u -s "@$ts" >/dev/null
# Witty Pi 4 MCU (bus 1, 0x08), registers 58-64: sec min hour date weekday month year, BCD, local time
bcd() { echo $(( 10#$1 / 10 * 16 + 10#$1 % 10 )); }
reg=58
for f in %S %M %H %d %u %m %y; do
  i2cset -y 1 0x08 $reg "$(bcd "$(date -d "@$ts" +$f)")"
  reg=$((reg + 1))
done
echo "$source" > /run/watercam-time-source
echo "clock and RTC set to $(date -Is)"
