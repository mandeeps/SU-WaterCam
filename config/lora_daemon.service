[Unit]
Description=LoRa handler daemon (owns the mDot serial port)
After=local-fs.target
# Must be fully up, with its socket present, before ticktalk.service starts --
# every LoRa call in ticktalk_main.py goes through this daemon now.
Before=ticktalk.service

[Service]
User=pi
Group=pi
Type=simple
WorkingDirectory=/home/pi/SU-WaterCam
# RuntimeDirectory creates /run/lora/ owned by User=pi at 0750,
# placing the socket outside world-writable /tmp.
RuntimeDirectory=lora
RuntimeDirectoryMode=0750
ExecStart=/home/pi/SU-WaterCam/venv/bin/python \
    /home/pi/SU-WaterCam/tools/lora_daemon.py \
    --socket /run/lora/lora.sock
Restart=on-failure
RestartSec=5
TimeoutStartSec=60
# Wait up to 30 s (60 x 0.5 s) for the socket to appear; fail cleanly if it doesn't.
# Succeeds as soon as the socket exists, fails after 30 s. (The previous
# `until ...; do ...; [ $retries -ge 60 ] && exit 1; done` exited 1 whenever the
# socket appeared after the first check: the loop's status is that of its last
# body command, the false `[ ... ] && exit 1`. The daemon takes about 1 s, so
# systemd killed a healthy daemon on every start.)
ExecStartPost=/bin/bash -c 'for i in $(seq 1 60); do [ -S /run/lora/lora.sock ] && exit 0; sleep 0.5; done; exit 1'

[Install]
WantedBy=multi-user.target
