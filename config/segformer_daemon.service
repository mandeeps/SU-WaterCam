[Unit]
Description=SegFormer 5-band ONNX inference daemon
# Start after local filesystems are mounted so the model path is accessible,
# but early enough to have the socket ready before ticktalk.service starts.
After=local-fs.target
Before=ticktalk.service

[Service]
User=pi
Group=pi
Type=simple
WorkingDirectory=/home/pi/segformer_5band
# Unbuffered stdout, so any print() output reaches the journal as it happens.
Environment=PYTHONUNBUFFERED=1
# RuntimeDirectory creates /run/segformer/ owned by User=pi at 0750,
# placing the socket outside world-writable /tmp.
RuntimeDirectory=segformer
RuntimeDirectoryMode=0750
ExecStart=/home/pi/SU-WaterCam/venv/bin/python \
    /home/pi/SU-WaterCam/tools/segformer_daemon.py \
    --model /home/pi/segformer_5band/segformer_5band_int8.onnx \
    --socket /run/segformer/segformer.sock
Restart=on-failure
RestartSec=5
TimeoutStartSec=90
# Wait up to 60 s (120 × 0.5 s) for the socket to appear; fail cleanly if it doesn't.
#
# Written as a for-loop with an explicit exit, not an until-loop. An until-loop
# returns the status of the last command run in its body, and the last command
# here would be `[ $retries -ge 60 ] && exit 1`, which is false-and-so-status-1
# on every iteration below the limit. The loop therefore reported failure in
# exactly the normal case: socket absent for one or more polls, then appearing.
# It only passed when the socket already existed on the first check, so the
# service could never start from cold.
ExecStartPost=/bin/bash -c 'for i in $(seq 1 120); do [ -S /run/segformer/segformer.sock ] && exit 0; sleep 0.5; done; exit 1'

# Sandbox (same in lora_daemon, segformer_daemon and powerlog).
# They need real devices (/dev/ttyAMA5, /dev/i2c-1, /dev/vcio) and share
# /tmp and /run/lock files with ticktalk, so no PrivateDevices, PrivateTmp or
# ProtectClock (which implies a device allow-list). They never call doas or
# sudo, so they can drop privilege escalation and all capabilities.
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ReadWritePaths=/home/pi /tmp /run/lock
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
