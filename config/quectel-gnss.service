[Unit]
Description=Enable Quectel EC25 GNSS subsystem
# Wait for the modem's AT port to appear on USB, not for network connectivity.
# The SIM data limit being exhausted must not block GPS.
# USB is off through boot (usb-power-off.service), so the port appears during
# the wake: start whenever it does, and stop when it goes away.
BindsTo=dev-ttyUSB2.device
After=dev-ttyUSB2.device ModemManager.service
Before=gpsd.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/quectel-gnss-enable
# gpsd was already running and missed the NMEA port; hand it over
ExecStartPost=-/usr/sbin/gpsdctl add /dev/ttyUSB1
RemainAfterExit=yes

[Install]
# Not wanted by gpsd.service: with USB off, gpsd would wait for the port.
WantedBy=dev-ttyUSB2.device
