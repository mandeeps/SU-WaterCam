[Unit]
Description=WittyPi power logger (one fsynced line a minute)
# Ordered only after local filesystems (plus systemd's default basic.target),
# so it is running within seconds of boot and catches boots that brown out early.
After=local-fs.target

[Service]
User=pi
Group=pi
Type=simple
# Standard library only, so the system python3 is enough.
ExecStart=/usr/bin/python3 /home/pi/SU-WaterCam/tools/powerlog.py
Restart=always
RestartSec=10

# Sandbox (same in lora_daemon, segformer_daemon and powerlog).
# They need real devices (/dev/ttyAMA5, /dev/i2c-1, /dev/vcio) and share
# /tmp and /run/lock files with ticktalk, so no PrivateDevices, PrivateTmp or
# ProtectClock (which implies a device allow-list). They never call doas or
# sudo, so they can drop privilege escalation and all capabilities.
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ReadWritePaths=/home/pi /tmp /run/lock
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
